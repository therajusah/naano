# ---------------------------------------------------------------------------
# Naano clone — environment variables
# Copy this file to `.env` and fill in the values.
#   cp .env.example .env
# `.env` is read by BOTH the Prisma CLI and Next.js, and is gitignored so
# secrets are never committed (OWASP-SECRETS-001).
# ---------------------------------------------------------------------------

# Postgres connection string. Matches docker-compose.yml (host port 5544).
DATABASE_URL="postgresql://naano:naano_dev_password@localhost:5544/naano?schema=public"

# Auth.js (NextAuth v5) session-signing secret.
# Generate one with:  openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-32-byte-random-string"

# Base URL of the app (used by Auth.js). Leave as-is for local dev.
AUTH_URL="http://localhost:3000"

# OpenAI API key — powers the AI campaign brief generator.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."

# Model used for brief generation (optional, has a safe default).
OPENAI_BRIEF_MODEL="gpt-4o-mini"
